FROM node:22.11.0-bookworm-slim

WORKDIR /app
RUN mkdir -p /app/web /app/.cache/app /app/.cache/showcase /app/web/dist \
    && chown -R node:node /app
USER node

# No credentials or dataset files enter the build context. Existing root
# dependencies (including tsx/undici) are reused alongside Express.
COPY --chown=node:node package*.json ./
RUN npm install --ignore-scripts --no-audit --no-fund
COPY --chown=node:node web/package.json ./web/package.json
RUN npm --prefix web install --ignore-scripts --no-audit --no-fund

EXPOSE 8080
CMD ["npm", "run", "app"]
