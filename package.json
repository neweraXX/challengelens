{
  "name": "challengelens",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "web:build": "node scripts/web-build.mjs",
    "showcase": "tsx scripts/build-showcase.ts",
    "app": "tsx src/api/server.ts",
    "web:test": "tsx --test tests/demo.test.ts",
    "app:typecheck": "tsc -p tsconfig.api.json",
    "typecheck": "tsc --noEmit",
    "pilot": "tsx scripts/data-pilot.ts",
    "packets": "tsx scripts/build-packets.ts",
    "pilot:eval": "tsx scripts/pilot-eval.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "4.21.2",
    "@noble/hashes": "1.8.0",
    "undici": "7.16.0"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "24.0.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
